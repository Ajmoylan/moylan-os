# MOYLAN//OS: files that must never be committed.

# Dependencies and build output
node_modules/
build/
dist/
.react-router/
*.tsbuildinfo
.eslintcache

# Test and coverage reports
coverage/
playwright-report/
test-results/
blob-report/

# Secrets and local configuration (docs/SECURITY.md §7)
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
local.settings.json
.azure/

# Private source material: master plans and agent reference artwork stay local
# (available for development, not published). See README.md.
docs/references/

# Local-only visual prototypes and experiments (e.g. the NEX design study); never published.
# Production code lives in src/; see docs/ARCHITECTURE.md §19.
prototypes/

# Local development-tool configuration and state (kept on each machine, never published)
.claude/

# Logs and OS/editor files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
